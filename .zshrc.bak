# Sanitized backup of ~/.zshrc — safe to copy/share. Add secrets locally, not here.

export ZSH=$HOME/.oh-my-zsh

# Custom theme: ~/.oh-my-zsh/custom/themes/agnoster-custom.zsh-theme
ZSH_THEME="agnoster-custom"

COMPLETION_WAITING_DOTS="true"

plugins=(git npm github you-should-use zsh-syntax-highlighting zsh-autosuggestions)

source $ZSH/oh-my-zsh.sh
source $HOME/.aliases/base
source $HOME/.aliases/work

# Secrets: load from 1Password, Keychain, or a private file (e.g. ~/.secrets.zsh), not this backup.
# export GITHUB_TOKEN=
# export OPENAI_API_KEY=
# export CLAUDE_CODE_USE_BEDROCK=1
# export ANTHROPIC_MODEL=

export N_PREFIX="$HOME/.local"
export PREFIX="$HOME/.local"
export PNPM_HOME="$HOME/Library/pnpm"

export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

PATH=":$HOME/bin"
PATH+=":$HOME/.local/bin"
PATH+=":/usr/local/bin:/usr/local/sbin"
PATH+=":/opt/homebrew/bin:/opt/homebrew/sbin"
PATH+=":/usr/bin:/usr/sbin"
PATH+=":/bin:/sbin"
PATH+=":$PNPM_HOME"
PATH+=":$HOME/.opencode/bin"

alias python="python3"
alias pip="pip3"

export PATH

eval "$(thefuck --alias)"

export LANG=en_US.UTF-8

echo "---------------"
echo "  GET ⚡️ DONE  "
echo "---------------"

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

if [ -f "$HOME/Desktop/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/Desktop/google-cloud-sdk/path.zsh.inc"; fi

if [ -f "$HOME/Desktop/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/Desktop/google-cloud-sdk/completion.zsh.inc"; fi
